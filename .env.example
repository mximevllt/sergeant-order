# Copiez ce fichier vers .env.local pour le développement local.
# Ne commitez jamais .env.local ni aucune valeur réelle.
APP_ENV=development
APP_URL=http://localhost:3000
COMPANY_TIMEZONE=Europe/Paris
SUPPORT_EMAIL=support@localhost.invalid

# Base SQLite locale. En production Vercel, utilisez l'URL et le jeton Turso.
TURSO_DATABASE_URL=file:./sergeant-paysage.local.db
TURSO_AUTH_TOKEN=

# Les services externes restent désactivés tant que leurs étapes ne sont pas réalisées.
EMAIL_DELIVERY_MODE=log
PAYMENT_MODE=disabled
AICI_MODE=disabled

# Authentification sans mot de passe et emails transactionnels
AUTH_SECRET=
INITIAL_ADMIN_EMAIL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Stripe (étape ultérieure — uniquement des clés de test en local)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Avance immédiate Urssaf (étape ultérieure — environnement de test en local)
URSSAF_CLIENT_ID=
URSSAF_CLIENT_SECRET=
URSSAF_API_BASE_URL=
URSSAF_NOVA_NUMBER=
ACCESS_DATA_ENCRYPTION_KEY=

# Observabilité et protection contre les abus (étapes ultérieures)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
