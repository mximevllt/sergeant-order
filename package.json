{
  "name": "sergeant-paysage-reservation",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "test": "next build --webpack && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "env:check": "node --env-file-if-exists=.env.local scripts/validate-environment.mjs",
    "env:check:all": "node --env-file-if-exists=.env.local scripts/validate-environment.mjs --require=all",
    "check": "npm run env:check && npm run lint && npm run typecheck && npm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate-database.mjs",
    "db:migrate:local": "node --env-file-if-exists=.env.local scripts/migrate-database.mjs",
    "db:seed:demo": "node --env-file-if-exists=.env.local scripts/seed-demo.mjs",
    "db:validate": "node --test tests/database-schema.test.mjs"
  },
  "dependencies": {
    "@libsql/client": "0.17.0",
    "@stripe/react-stripe-js": "6.8.2",
    "@stripe/stripe-js": "9.14.0",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "stripe": "22.5.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "type": "module"
}
