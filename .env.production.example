# Modèle de production. Ne jamais placer de vraie valeur dans ce fichier suivi par Git.
APP_ENV=production
APP_URL=https://replace-with-the-final-domain.example
COMPANY_TIMEZONE=Europe/Paris
SUPPORT_EMAIL=replace-with-the-real-support-address@example.invalid
TURSO_DATABASE_URL=libsql://replace-with-the-production-database.turso.io
TURSO_AUTH_TOKEN=replace-in-the-vercel-secret-store
EMAIL_DELIVERY_MODE=live
PAYMENT_MODE=live
AICI_MODE=live

AUTH_SECRET=replace-in-the-hosting-secret-store
INITIAL_ADMIN_EMAIL=replace-with-the-initial-admin-email
# Optionnel : limitez temporairement les accès entreprise à ces adresses séparées par des virgules.
STAFF_ALLOWED_EMAILS=admin1@example.com,admin2@example.com
# Interdit en production réelle. Valeur temporaire possible : enabled.
TEST_ADMIN_BYPASS=
RESEND_API_KEY=replace-in-the-hosting-secret-store
RESEND_FROM_EMAIL=replace-with-the-verified-production-sender
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_replace_me
URSSAF_CLIENT_ID=replace-in-the-hosting-secret-store
URSSAF_CLIENT_SECRET=replace-in-the-hosting-secret-store
URSSAF_API_BASE_URL=https://replace-with-urssaf-production-endpoint.example
URSSAF_NOVA_NUMBER=replace-with-the-production-nova-number
ACCESS_DATA_ENCRYPTION_KEY=replace-in-the-hosting-secret-store
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
